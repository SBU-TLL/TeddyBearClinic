###############################################################################
# TeddyBearClinic — production environment template
#
# Copy to your runtime secret store / Azure container env (do NOT commit a real
# .env). Values here are PLACEHOLDERS. The container reads these at runtime;
# nothing is baked into the image (.dockerignore excludes .env*).
###############################################################################

# --- Environment flag --------------------------------------------------------
APP_ENV=production
TZ=America/New_York

# --- Ingress / routing -------------------------------------------------------
PUBLIC_HOSTNAME=teddybearclinic.<your-subdomain>.stonybrook.edu
# Apache listens on 8080 inside the container (non-root); ingress forwards
# 443 -> 8080. "/" serves the static game (index.html).
APACHE_LISTEN_PORT=8080

# --- Credly API credentials (REQUIRED for the certificate/ badge flow) -------
# certificate/*.php call the Credly v1.1 REST API to issue badges. These were
# previously HARDCODED in credlyAPI.php (now read via getenv); supply the
# CURRENT/ROTATED values here. (See the security note at the bottom.)
CREDLY_API_DOMAIN=https://api.credly.com/v1.1
CREDLY_API_KEY=your_credly_api_key
CREDLY_API_SECRET=your_credly_api_secret
CREDLY_ACCESS_TOKEN=your_credly_access_token
CREDLY_APP_ID=your_credly_app_id            # e.g. 693

# --- Credly badging service account (REQUIRED for getToken.php) --------------
CREDLY_ACCOUNT_EMAIL=digitalbadging@connect.stonybrook.edu
CREDLY_ACCOUNT_PASSWORD=your_service_account_password

# --- Authentication (Shibboleth at the ingress) ------------------------------
# certificate/giveYourselfCredit.php is Shibboleth-protected (reads $_SERVER
# mail/nickname/sn). Shibboleth is enforced at the ingress / reverse proxy
# (Ansible-managed); the <IfModule mod_shib> guard is inert without mod_shib.
#   -> The Azure/Ansible deploy MUST assert mod_shib is loaded at the gate.

# --- Storage / SaveData ------------------------------------------------------
# certificate/SaveData.php APPENDS players to a HARDCODED absolute path:
#   /home/tltsecure/apache2/htdocs/userData/TeddyBearClinic/players.csv
# The image creates that dir writable; mount a persistent volume there so the
# CSV survives redeploys:
#   docker run -v tbc-userdata:/home/tltsecure/apache2/htdocs/userData/TeddyBearClinic ...
# (Flagged: hardcoded absolute path is not portable — make it relative/env-driven
#  for Azure.) No SQL database.

###############################################################################
# SECURITY — the previously-committed Credly API key/secret/access-token +
# service-account password remain in this repo's GIT HISTORY (and were shared
# with the Badger repo). They MUST be rotated in Credly and the SBU account, and
# ideally purged from history (git filter-repo / BFG). Externalizing to env vars
# stops NEW images from leaking them, but does not undo past exposure.
###############################################################################
